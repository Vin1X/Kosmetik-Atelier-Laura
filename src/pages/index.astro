---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kosmetik Atelier Laura">
    <main class="bg-[#274727]">
        <section
            class="relative overflow-hidden bg-[#1f3020] py-16 md:py-28 px-4"
        >
            <div
                class="relative z-10 max-w-4xl mx-auto flex flex-col items-center text-center md:text-left md:items-start"
            >
                <h1 class="font-serif text-white leading-tight mb-4">
                    <span
                        class="block text-4xl sm:text-5xl md:text-7xl font-semibold tracking-tight uppercase"
                    >
                        Ihr Vertrauen
                    </span>
                    <span
                        class="block text-3xl sm:text-4xl md:text-6xl text-custom-gold italic font-light mt-2"
                    >
                        unsere Priorität
                    </span>
                </h1>

                <div
                    class="flex items-center gap-3 my-8 justify-center md:justify-start w-full"
                >
                    <div class="h-px w-10 bg-custom-gold/60"></div>
                    <svg
                        viewBox="0 0 40 12"
                        class="w-10 h-3 fill-custom-gold/60"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
                        ></path>
                    </svg>
                    <div class="h-px w-10 bg-custom-gold/60"></div>
                </div>

                <ul
                    class="flex flex-col gap-5 text-left w-full max-w-2xl md:max-w-none"
                >
                    <li class="flex items-center gap-4">
                        <div
                            class="w-12 h-12 rounded-full border-2 border-custom-gold/60 flex items-center justify-center shrink-0"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                class="w-4 h-4 stroke-custom-gold fill-none"
                                stroke-width="1.5"
                            >
                                <path
                                    d="M12 2C9 2 6 4.5 6 8c0 4 6 10 6 10s6-6 6-10c0-3.5-3-6-6-6z"
                                ></path>
                                <circle cx="12" cy="8" r="2"></circle>
                            </svg>
                        </div>
                        <p
                            class="text-gray-300 font-serif text-lg md:text-2xl leading-relaxed"
                        >
                            Zeit, Ruhe und ein offenes Ohr.<br
                                class="hidden sm:inline"
                            />So empfangen und begleiten wir Sie.
                        </p>
                    </li>

                    <hr class="ml-16 border-custom-gold/20" />

                    <li class="flex items-center gap-4">
                        <div
                            class="w-12 h-12 rounded-full border-2 border-custom-gold/60 flex items-center justify-center shrink-0"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                class="w-4 h-4 stroke-custom-gold fill-none"
                                stroke-width="1.5"
                            >
                                <path
                                    d="M12 21C12 21 4 14 4 9a8 8 0 0116 0c0 5-8 12-8 12z"
                                ></path>
                            </svg>
                        </div>
                        <p
                            class="text-gray-300 font-serif text-lg md:text-2xl leading-relaxed"
                        >
                            Individuell. Wunschgemäß. Für Sie.
                        </p>
                    </li>
                </ul>
            </div>
        </section>

        <section class="overflow-hidden py-16 md:py-24 px-4">
            <div
                class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 md:items-stretch"
            >
                <div class="flex flex-col justify-between h-full">
                    <div>
                        <p
                            class="text-custom-gold text-lg md:text-xl tracking-[0.3em] uppercase mb-2 font-sans"
                        >
                            Leidenschaft · Präzision · Perfektion
                        </p>
                        <p
                            class="font-serif text-xl md:text-2xl text-gray-300 tracking-widest leading-snug uppercase"
                        >
                            Nicht nur Worte –<br />sondern der Standard unserer
                            Arbeit.
                        </p>
                        <hr
                            class="w-full h-px border border-custom-gold/60 my-6 rounded-lg"
                        />
                    </div>

                    <ul class="flex flex-col gap-4 justify-between flex-1">
                        {
                            [
                                {
                                    icon: "M12 2C9 2 6 4.5 6 8c0 4 6 10 6 10s6-6 6-10c0-3.5-3-6-6-6z",
                                    text: "Individualität steht bei uns im Mittelpunkt. Jede Behandlung wird genau auf Ihre Haut und Ihre Bedürfnisse abgestimmt.",
                                },
                                {
                                    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
                                    text: "Als zertifizierte Kosmetikerin mit umfangreicher Weiterbildung – u.a. in Microneedling – betreue ich Sie mit voller Aufmerksamkeit.",
                                },
                                {
                                    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
                                    text: "Hier geht es nicht um Abarbeiten – hier geht es um Sie. Sie stehen bei uns im Mittelpunkt jeder Behandlung.",
                                },
                                {
                                    icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
                                    text: "Unser Studio bietet ein Ambiente, das den Alltag leiser werden lässt – ein Ort, an dem auch Sie zur Ruhe kommen.",
                                },
                            ].map(({ icon, text }) => (
                                <li class="flex items-center gap-4 py-2">
                                    <div class="w-12 h-12 rounded-full border border-custom-gold/60 flex items-center justify-center shrink-0">
                                        <svg
                                            viewBox="0 0 24 24"
                                            class="w-3.5 h-3.5 stroke-custom-gold fill-none"
                                            stroke-width="1.5"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d={icon}
                                            />
                                        </svg>
                                    </div>
                                    <p class="text-gray-300 text-sm leading-relaxed font-serif">
                                        {text}
                                    </p>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="relative h-full min-h-[400px] md:min-h-0">
                    <div
                        class="w-full h-full bg-gray-100 rounded-lg flex items-center justify-center text-gray-400 text-sm tracking-widest uppercase border border-gray-200"
                    >
                        [ Bild Placeholder ]
                    </div>
                    <div
                        class="absolute -bottom-4 -right-4 w-24 h-24 border border-custom-gold/30 rounded -z-10"
                    >
                    </div>
                </div>
            </div>
        </section>

        <div class="flex items-center gap-3 justify-center py-4">
            <div class="h-px w-10 bg-custom-gold/60"></div>
            <svg
                viewBox="0 0 40 12"
                class="w-10 h-3 fill-custom-gold/60"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
                ></path>
            </svg>
            <div class="h-px w-10 bg-custom-gold/60"></div>
        </div>

        <section class="px-4 py-16">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-12">
                    <p
                        class="text-custom-gold text-xs tracking-[0.3em] uppercase mb-3 font-sans"
                    >
                        Unsere Leistungen
                    </p>
                    <h2
                        class="font-serif text-2xl md:text-4xl text-gray-300 tracking-wide"
                    >
                        Ganzheitliche Pflege für Sie
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {
                        [
                            {
                                title: "Ganzheitliche Pflege",
                                sub: "Für Haut, Körper und Seele.",
                                icon: "M5 3a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2H5zm0 0",
                                image: "Placeholder",
                            },
                            {
                                title: "Hochwertige Produkte",
                                sub: "Natürliche Inhaltsstoffe. Sichtbare Ergebnisse.",
                                icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
                                image: "Placeholder",
                            },
                            {
                                title: "Exklusives Ambiente",
                                sub: "Luxus, der nicht laut ist – aber spürbar.",
                                icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
                                image: "Placeholder",
                            },
                        ].map(({ title, sub, icon, image }) => (
                            <div class="bg-[#274727] border-2 border-custom-gold rounded-lg flex flex-col items-center text-center hover:border-custom-gold/30 transition-colors duration-200 overflow-hidden">
                                <div class="p-8 pb-6 flex flex-col items-center gap-4 flex-1">
                                    <div class="w-14 h-14 rounded-full border-2 border-custom-gold/60 flex items-center justify-center">
                                        <svg
                                            viewBox="0 0 24 24"
                                            class="w-5 h-5 stroke-custom-gold fill-none"
                                            stroke-width="1.5"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d={icon}
                                            />
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="font-sans text-xs tracking-[0.2em] uppercase text-custom-gold mb-2">
                                            {title}
                                        </p>
                                        <p class="text-gray-300 text-sm font-serif leading-relaxed">
                                            {sub}
                                        </p>
                                    </div>
                                </div>

                                <div class="w-full aspect-4/3 bg-gray-100 flex items-center justify-center text-gray-400 text-sm tracking-widest border-t-custom-gold border-t-2">
                                    {image}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <div class="flex items-center gap-3 justify-center py-4">
            <div class="h-px w-10 bg-custom-gold/60"></div>
            <svg
                viewBox="0 0 40 12"
                class="w-10 h-3 fill-custom-gold/60"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
                ></path>
            </svg>
            <div class="h-px w-10 bg-custom-gold/60"></div>
        </div>

        <section class="mx-auto px-4 text-center py-16 md:py-24">
            <p
                class="text-custom-gold text-xl md:text-2xl tracking-[0.2em] uppercase mb-4 font-sans px-2"
            >
                Schönheit ist Vertrauenssache.
            </p>
            <h2
                class="font-serif text-gray-200 text-lg md:text-xl mb-8 italic font-light"
            >
                Wir freuen uns darauf, Sie kennenzulernen.
            </h2>

            <a
                href="/kontakt"
                class="inline-block w-full sm:w-auto px-8 py-4 rounded-lg border border-custom-gold text-custom-gold font-sans text-xs md:text-sm tracking-widest uppercase hover:bg-custom-gold hover:text-[#274727] transition-colors duration-200"
            >
                Termin vereinbaren
            </a>
        </section>
    </main>
</Layout>
