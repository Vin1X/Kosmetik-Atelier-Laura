---
import Layout from "../layouts/Layout.astro";

import { Image } from "astro:assets";
import indexPhoto from "../assets/index_photo.jpeg";
import localBirdImage from "../assets/image21.webp";

import afterImage from "../assets/image2.jpeg";
---

<Layout title="Kosmetik Atelier Laura">
    <section
        class="relative min-h-[85vh] pt-46 md:pt-128 pb-16 md:pb-24 px-4 md:px-8 lg:px-12 bg-custom-green section-depth w-full flex flex-col justify-center"
        style={`background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.5)), url('${indexPhoto.src}'); background-size: cover; background-position: 85% center;`}
    >
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-custom-gold/10 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-40 -right-24 w-80 h-80 rounded-full bg-custom-gold/5 blur-3xl"
            >
            </div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto w-full reveal">
            <div
                class="max-w-xl md:max-w-2xl flex flex-col items-center text-center md:items-start md:text-left"
            >
                <p
                    class="text-custom-gold text-xs md:text-sm tracking-[0.35em] uppercase mb-6 font-sans"
                >
                    Kosmetik Atelier Laura · Berlin
                </p>

                <h1 class="leading-tight mb-4">
                    <span
                        class="block text-4xl sm:text-5xl md:text-7xl font-semibold tracking-tight uppercase text-custom-white font-serif"
                    >
                        Ihr Vertrauen
                    </span>
                    <span
                        class="block text-3xl sm:text-4xl md:text-6xl text-custom-gold italic font-light mt-2"
                    >
                        unsere Priorität
                    </span>
                </h1>

                <div
                    class="flex items-center gap-3 my-8 justify-center md:justify-start w-full"
                >
                    <div class="h-px w-10 bg-custom-gold"></div>
                    <svg
                        viewBox="0 0 40 12"
                        class="w-10 h-3 fill-custom-gold"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
                        ></path>
                    </svg>
                    <div class="h-px w-10 bg-custom-gold"></div>
                </div>

                <ul class="flex flex-col gap-5 text-left w-full">
                    <li class="flex items-center gap-4">
                        <div
                            class="w-12 h-12 rounded-full border-2 border-custom-gold flex items-center justify-center shrink-0"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                class="w-4 h-4 stroke-custom-gold fill-none"
                                stroke-width="1.5"
                            >
                                <path
                                    d="M12 2C9 2 6 4.5 6 8c0 4 6 10 6 10s6-6 6-10c0-3.5-3-6-6-6z"
                                ></path>
                                <circle cx="12" cy="8" r="2"></circle>
                            </svg>
                        </div>
                        <p
                            class="text-custom-white font-serif text-lg md:text-2xl leading-relaxed"
                        >
                            Zeit, Ruhe und ein offenes Ohr.<br />So empfangen
                            und begleiten wir Sie.
                        </p>
                    </li>

                    <hr class="ml-16 border-custom-gold" />

                    <li class="flex items-center gap-4">
                        <div
                            class="w-12 h-12 rounded-full border-2 border-custom-gold flex items-center justify-center shrink-0"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                class="w-4 h-4 stroke-custom-gold fill-none"
                                stroke-width="1.5"
                            >
                                <path
                                    d="M12 21C12 21 4 14 4 9a8 8 0 0116 0c0 5-8 12-8 12z"
                                ></path>
                            </svg>
                        </div>
                        <p
                            class="text-custom-white font-serif text-lg md:text-2xl leading-relaxed"
                        >
                            Individuell. Wunschgemäß. Für Sie.
                        </p>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <section class="overflow-hidden py-16 px-4 bg-custom-green">
        <div
            class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 md:items-stretch reveal"
        >
            <div class="flex flex-col justify-between h-full">
                <div>
                    <p
                        class="text-custom-gold text-lg md:text-xl tracking-[0.3em] uppercase mb-2 font-sans"
                    >
                        Leidenschaft · Präzision · Perfektion
                    </p>
                    <p
                        class="font-serif text-xl md:text-2xl text-custom-white tracking-widest leading-snug uppercase"
                    >
                        Nicht nur Worte –<br />sondern der Standard unserer
                        Arbeit.
                    </p>
                    <hr
                        class="w-full h-px border border-custom-gold my-6 rounded-lg"
                    />
                </div>

                <ul class="flex flex-col gap-4 justify-between flex-1">
                    {
                        [
                            {
                                icon: "M12 2C9 2 6 4.5 6 8c0 4 6 10 6 10s6-6 6-10c0-3.5-3-6-6-6z",
                                text: "Individualität steht bei uns im Mittelpunkt. Jede Behandlung wird genau auf Ihre Haut und Ihre Bedürfnisse abgestimmt.",
                            },
                            {
                                icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
                                text: "Als zertifizierte Kosmetikerin mit umfangreicher Weiterbildung – u.a. in Microneedling – betreue ich Sie mit voller Aufmerksamkeit.",
                            },
                            {
                                icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
                                text: "Hier geht es nicht um Abarbeiten – hier geht es um Sie. Sie stehen bei uns im Mittelpunkt jeder Behandlung.",
                            },
                            {
                                icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
                                text: "Unser Studio bietet ein Ambiente, das den Alltag leiser werden lässt – ein Ort, an dem auch Sie zur Ruhe kommen.",
                            },
                        ].map(({ icon, text }) => (
                            <li class="flex items-center gap-4 py-2">
                                <div class="w-12 h-12 rounded-full border border-custom-gold flex items-center justify-center shrink-0">
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="w-3.5 h-3.5 stroke-custom-gold fill-none"
                                        stroke-width="1.5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d={icon}
                                        />
                                    </svg>
                                </div>
                                <p class="text-custom-white text-sm leading-relaxed font-serif">
                                    {text}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="relative w-full h-full min-h-100 md:min-h-0">
                <Image
                    src={localBirdImage}
                    alt="A bird sitting on a nest of eggs."
                    class="md:absolute md:inset-0 w-full h-full object-cover rounded-lg border-2 border-custom-gold"
                />
            </div>
        </div>
    </section>

    <div class="flex items-center gap-3 justify-center py-4 bg-custom-green">
        <div class="h-px w-10 bg-custom-gold"></div>
        <svg
            viewBox="0 0 40 12"
            class="w-10 h-3 fill-custom-gold"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
            ></path>
        </svg>
        <div class="h-px w-10 bg-custom-gold"></div>
    </div>

    <section
        class="relative overflow-hidden py-20 md:pt-16 px-4 bg-custom-green section-depth-b"
    >
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute top-1/3 -right-40 w-md h-112 rounded-full bg-custom-gold/8 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-custom-light-gold/5 blur-3xl"
            >
            </div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto reveal">
            <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
                <p
                    class="text-custom-gold text-xs md:text-sm tracking-[0.3em] uppercase mb-3 font-sans"
                >
                    Ionto Comed Gerätetechnik
                </p>
                <h2
                    class="font-serif text-3xl md:text-5xl text-custom-white mb-4"
                >
                    Unsere gefragtesten Behandlungen
                </h2>
                <p
                    class="font-serif text-custom-white/70 text-base md:text-lg italic font-light"
                >
                    Sichtbare Hauterneuerung mit professioneller Gerätetechnik –
                    für Ergebnisse, die man sieht und spürt.
                </p>
            </div>

            <div class="flex flex-col gap-24 md:gap-32">
                <!-- 1. MICRONEEDLING -->
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center"
                >
                    <div class="relative order-1">
                        <div
                            class="absolute -inset-3 md:-inset-5 border border-custom-gold rounded-lg -z-10 translate-x-3 translate-y-3 md:translate-x-5 md:translate-y-5"
                        >
                        </div>

                        <div
                            class="before-after-container relative w-full aspect-4/5 rounded-lg border border-custom-gold/20 overflow-hidden select-none"
                        >
                            <Image
                                src={afterImage}
                                alt="Microneedling Ergebnis Nachher"
                                class="absolute inset-0 w-full h-full object-cover"
                            />
                            <span
                                class="absolute bottom-3 right-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                            >
                                Nachher
                            </span>

                            <div
                                class="before-img-wrapper absolute inset-0 w-full h-full z-10 overflow-hidden"
                                style="clip-path: inset(0 50% 0 0);"
                            >
                                <Image
                                    src={localBirdImage}
                                    alt="Microneedling Hautzustand Vorher"
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                                <span
                                    class="absolute bottom-3 left-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                                >
                                    Vorher
                                </span>
                            </div>

                            <div
                                class="slider-line absolute top-0 bottom-0 left-1/2 w-0.5 bg-custom-gold z-20 pointer-events-none -translate-x-1/2"
                            >
                                <div
                                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-custom-gold text-custom-green flex items-center justify-center shadow-xl"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="w-4 h-4 stroke-custom-green fill-none"
                                        stroke-width="2.5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M8 7l-5 5 5 5M16 7l5 5-5 5"
                                        ></path>
                                    </svg>
                                </div>
                            </div>

                            <input
                                type="range"
                                min="0"
                                max="100"
                                value="50"
                                aria-label="Vorher und Nachher Vergleich verstellen"
                                class="before-after-slider absolute inset-0 w-full h-full opacity-0 z-30 cursor-ew-resize"
                            />
                        </div>
                    </div>

                    <div class="order-2">
                        <p
                            class="text-custom-gold text-xs md:text-sm tracking-[0.25em] uppercase mb-3 font-sans"
                        >
                            Kollagen-Induktion
                        </p>
                        <h3
                            class="font-serif text-3xl md:text-4xl text-custom-white mb-4"
                        >
                            Microneedling
                        </h3>
                        <p
                            class="text-custom-white/80 font-serif text-base md:text-lg leading-relaxed mb-6"
                        >
                            Mit dem Microneedling-Gerät von Ionto Comed setzen
                            wir feinste, kontrollierte Mikroimpulse in der
                            obersten Hautschicht – der natürliche Auslöser für
                            die körpereigene Kollagenbildung.
                        </p>
                        <ul class="flex flex-col gap-3 mb-8">
                            {
                                [
                                    "Individuelle Nadeltiefe für Ihren Hauttyp",
                                    "Angeregte Kollagen- und Elastinproduktion",
                                    "Feinere Poren, glattere Textur, weniger Linien",
                                    "Intensive Einschleusung hochwirksamer Wirkstoffe",
                                ].map((point) => (
                                    <li class="flex items-start gap-3">
                                        <svg
                                            viewBox="0 0 24 24"
                                            class="w-4 h-4 mt-1 stroke-custom-gold fill-none shrink-0"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M5 13l4 4L19 7"
                                            />
                                        </svg>
                                        <span class="text-custom-white/90 text-sm font-serif leading-relaxed">
                                            {point}
                                        </span>
                                    </li>
                                ))
                            }
                        </ul>
                        <a
                            href="/kontakt"
                            class="inline-flex items-center gap-2 text-custom-gold text-xs md:text-sm tracking-widest uppercase font-sans border-b border-custom-gold pb-1 hover:gap-3 transition-all duration-300"
                        >
                            Termin für Microneedling anfragen
                            <svg
                                viewBox="0 0 24 24"
                                class="w-4 h-4 stroke-custom-gold fill-none"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13 7l5 5-5 5M6 12h12"></path>
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- 2. MIKRODERMABRASION -->
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center"
                >
                    <div class="order-2 md:order-1">
                        <p
                            class="text-custom-gold text-xs md:text-sm tracking-[0.25em] uppercase mb-3 font-sans"
                        >
                            Sanfte Tiefenreinigung
                        </p>
                        <h3
                            class="font-serif text-3xl md:text-4xl text-custom-white mb-4"
                        >
                            Mikrodermabrasion
                        </h3>
                        <p
                            class="text-custom-white/80 font-serif text-base md:text-lg leading-relaxed mb-6"
                        >
                            Die Mikrodermabrasion von Ionto Comed trägt
                            abgestorbene Hautzellen sanft und kristallfrei ab
                            und regt gleichzeitig die Durchblutung an.
                        </p>
                        <ul class="flex flex-col gap-3 mb-8">
                            {
                                [
                                    "Porentiefe Reinigung ganz ohne Reizung",
                                    "Sofort sichtbarer Frische-Effekt",
                                    "Ideal als Vorbereitung für weitere Behandlungen",
                                    "Geeignet für nahezu jeden Hauttyp",
                                ].map((point) => (
                                    <li class="flex items-start gap-3">
                                        <svg
                                            viewBox="0 0 24 24"
                                            class="w-4 h-4 mt-1 stroke-custom-gold fill-none shrink-0"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M5 13l4 4L19 7"
                                            />
                                        </svg>
                                        <span class="text-custom-white/90 text-sm font-serif leading-relaxed">
                                            {point}
                                        </span>
                                    </li>
                                ))
                            }
                        </ul>
                        <a
                            href="/kontakt"
                            class="inline-flex items-center gap-2 text-custom-gold text-xs md:text-sm tracking-widest uppercase font-sans border-b border-custom-gold pb-1 hover:gap-3 transition-all duration-300"
                        >
                            Termin für Mikrodermabrasion anfragen
                            <svg
                                viewBox="0 0 24 24"
                                class="w-4 h-4 stroke-custom-gold fill-none"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13 7l5 5-5 5M6 12h12"></path>
                            </svg>
                        </a>
                    </div>

                    <div class="relative order-1 md:order-2">
                        <div
                            class="absolute -inset-3 md:-inset-5 border border-custom-gold/50 rounded-lg -z-10 -translate-x-3 translate-y-3 md:-translate-x-5 md:translate-y-5"
                        >
                        </div>

                        <div
                            class="before-after-container relative w-full aspect-4/5 rounded-lg border border-custom-gold/20 overflow-hidden select-none"
                        >
                            <Image
                                src={afterImage}
                                alt="Mikrodermabrasion Ergebnis Nachher"
                                class="absolute inset-0 w-full h-full object-cover"
                            />
                            <span
                                class="absolute bottom-3 right-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                            >
                                Nachher
                            </span>

                            <div
                                class="before-img-wrapper absolute inset-0 w-full h-full z-10 overflow-hidden"
                                style="clip-path: inset(0 50% 0 0);"
                            >
                                <Image
                                    src={localBirdImage}
                                    alt="Mikrodermabrasion Zustand Vorher"
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                                <span
                                    class="absolute bottom-3 left-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                                >
                                    Vorher
                                </span>
                            </div>

                            <div
                                class="slider-line absolute top-0 bottom-0 left-1/2 w-0.5 bg-custom-gold z-20 pointer-events-none -translate-x-1/2"
                            >
                                <div
                                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-custom-gold text-custom-green flex items-center justify-center shadow-xl"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="w-4 h-4 stroke-custom-green fill-none"
                                        stroke-width="2.5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M8 7l-5 5 5 5M16 7l5 5-5 5"
                                        ></path>
                                    </svg>
                                </div>
                            </div>

                            <input
                                type="range"
                                min="0"
                                max="100"
                                value="50"
                                aria-label="Vorher und Nachher Vergleich verstellen"
                                class="before-after-slider absolute inset-0 w-full h-full opacity-0 z-30 cursor-ew-resize"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-center py-4 bg-custom-green">
            <div class="h-px w-10 bg-custom-gold"></div>
            <svg
                viewBox="0 0 40 12"
                class="w-10 h-3 fill-custom-gold"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
                ></path>
            </svg>
            <div class="h-px w-10 bg-custom-gold"></div>
        </div>
    </section>

    <section class="px-4 py-8 md:py-16 bg-custom-green section-depth-alt">
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute top-0 left-1/4 w-72 h-72 rounded-full bg-custom-gold/6 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-24 -right-32 w-96 h-96 rounded-full bg-custom-gold/5 blur-3xl"
            >
            </div>
        </div>
        <div class="max-w-6xl mx-auto reveal">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    [
                        {
                            title: "Ganzheitliche Pflege",
                            sub: "Für Haut, Körper und Seele.",
                            icon: "M5 3a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2H5zm0 0",
                            image: { localBirdImage },
                        },
                        {
                            title: "Hochwertige Produkte",
                            sub: "Wirksame Inhaltsstoffe. Sichtbare Ergebnisse.",
                            icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
                            image: { localBirdImage },
                        },
                        {
                            title: "Exklusives Ambiente",
                            sub: "Luxus, der nicht laut ist – aber spürbar.",
                            icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z",
                            image: { localBirdImage },
                        },
                    ].map(({ title, sub, icon, image }) => (
                        <div class="bg-custom-light-green border-2 border-custom-gold rounded-lg flex flex-col items-center text-center overflow-hidden card-elevated hover:gold-glow-lg hover:-translate-y-1.5 transition-all duration-500">
                            <div class="p-8 pb-6 flex flex-col items-center gap-4 flex-1">
                                <div class="w-14 h-14 rounded-full bg-custom-gold/10 border-2 border-custom-gold flex items-center justify-center">
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="w-5 h-5 stroke-custom-gold fill-none"
                                        stroke-width="1.5"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d={icon}
                                        />
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-sans text-xs tracking-[0.2em] uppercase text-custom-gold mb-2">
                                        {title}
                                    </p>
                                    <p class="text-custom-white text-sm font-serif leading-relaxed">
                                        {sub}
                                    </p>
                                </div>
                            </div>

                            <div class="relative w-full aspect-4/3">
                                <Image
                                    src={localBirdImage}
                                    alt={`Bild zu ${title}`}
                                    class="w-full h-full object-cover border-t-2 border-t-custom-gold"
                                    width="400"
                                    height="300"
                                />
                                <div class="absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-custom-green to-transparent" />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <div
            class="flex items-center gap-3 justify-center py-8 bg-custom-green"
        >
            <div
                class="absolute inset-0 overflow-hidden -z-10 pointer-events-none"
            >
                <div
                    class="absolute top-0 left-1/2 w-48 h-48 rounded-full bg-custom-gold/6 blur-3xl"
                >
                </div>
                <div
                    class="absolute -bottom-12 -right-24 w-72 h-72 rounded-full bg-custom-gold/5 blur-3xl"
                >
                </div>
            </div>
            <div class="h-px w-10 bg-custom-gold"></div>
            <svg
                viewBox="0 0 40 12"
                class="w-10 h-3 fill-custom-gold"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
                ></path>
            </svg>
            <div class="h-px w-10 bg-custom-gold"></div>
        </div>
    </section>

    <section
        class="relative overflow-hidden mx-auto px-4 text-center py-8 md:py-16 bg-custom-green section-depth"
    >
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[36rem] h-64 rounded-full bg-custom-gold/6 blur-3xl"
            >
            </div>
        </div>
        <div class="reveal relative z-10">
            <p
                class="text-custom-gold text-xl md:text-2xl tracking-[0.2em] uppercase mb-4 font-sans px-2"
            >
                Schönheit ist Vertrauenssache.
            </p>
            <h2
                class="font-serif text-custom-white text-lg md:text-xl mb-8 italic font-light"
            >
                Wir freuen uns darauf, Sie kennenzulernen.
            </h2>

            <a
                href="/kontakt"
                class="inline-block w-full sm:w-auto px-8 py-4 rounded-lg border border-custom-gold text-custom-gold font-sans text-xs md:text-sm tracking-widest uppercase gold-glow hover:gold-glow-lg hover:bg-custom-gold hover:text-custom-green transition-all duration-300"
            >
                Jetzt kontaktieren und Termin vereinbaren
            </a>
        </div>
    </section>
</Layout>

<script>
    const revealEls = document.querySelectorAll(".reveal");

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("reveal-visible");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
    );

    revealEls.forEach((el) => observer.observe(el));

    function setupBeforeAfterSliders() {
        const containers = document.querySelectorAll(".before-after-container");

        containers.forEach((container) => {
            const slider = container.querySelector(
                ".before-after-slider",
            ) as HTMLInputElement;
            const beforeWrapper = container.querySelector(
                ".before-img-wrapper",
            ) as HTMLElement;
            const line = container.querySelector(".slider-line") as HTMLElement;

            if (!slider || !beforeWrapper || !line) return;

            const updateSlider = () => {
                const value = slider.value;
                beforeWrapper.style.clipPath = `inset(0 ${100 - Number(value)}% 0 0)`;
                line.style.left = `${value}%`;
            };

            slider.addEventListener("input", updateSlider);
            // Für Touch-Geräte
            slider.addEventListener("change", updateSlider);
        });
    }

    setupBeforeAfterSliders();

    document.addEventListener("astro:page-load", setupBeforeAfterSliders);
</script>
