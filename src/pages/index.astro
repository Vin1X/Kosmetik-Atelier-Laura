---
import Layout from "../layouts/Layout.astro";
import Ionto from "../components/Ionto.astro";
import Faq from "../components/Faq.astro";

import { Image } from "astro:assets";
import indexPhoto from "../assets/index_photo.webp";
import localBirdImage from "../assets/image21.webp";

import ionto_light from "../assets/ionto_light.webp";

import LeafIcon from "../assets/LeafIcon.svg";
import CandleIcon from "../assets/CandleIcon.svg";
import PillarIcon from "../assets/PillarIcon.svg";
import LotusIcon from "../assets/LotusIcon.svg";
import CertificateIcon from "../assets/CertificateIcon.svg";
import StarIcon from "../assets/StarIcon.svg";
import PersonIcon from "../assets/PersonIcon.svg";
import HourglassIcon from "../assets/HourglassIcon.svg";
import FlaskIcon from "../assets/FlaskIcon.svg";
import Eucalyptus from "../assets/Eucalyptus.svg";

import bigwork from "../assets/StudioImages/bigwork.webp";

import work from "../assets/StudioImages/work.webp";
---

<Layout title="Kosmetik Atelier Laura">
    <section
        class="relative min-h-[85vh] pt-46 md:pt-128 pb-16 md:pb-24 px-4 md:px-8 lg:px-12 bg-custom-green section-depth w-full flex flex-col justify-center"
        style={`background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.5)), url('${indexPhoto.src}'); background-size: cover; background-position: 85% 85%;`}
    >
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-custom-gold/10 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-40 -right-24 w-80 h-80 rounded-full bg-custom-gold/5 blur-3xl"
            >
            </div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto w-full reveal">
            <div
                class="max-w-xl md:max-w-2xl flex flex-col items-center text-center md:items-start md:text-left"
            >
                <p
                    class="text-custom-gold text-xs md:text-sm tracking-[0.35em] uppercase mb-6 font-sans"
                >
                    Kosmetik Atelier Laura · Berlin
                </p>

                <h1 class="leading-tight mb-4">
                    <span
                        class="block text-4xl sm:text-5xl md:text-7xl font-semibold tracking-tight uppercase text-custom-white font-serif"
                    >
                        Ihr Vertrauen
                    </span>
                    <span
                        class="block text-3xl sm:text-4xl md:text-6xl text-custom-gold italic font-light mt-2"
                    >
                        unsere Priorität
                    </span>
                </h1>

                <div class="my-2 flex justify-center">
                    <Eucalyptus class="fill-custom-gold" />
                </div>

                <ul class="flex flex-col gap-5 text-left w-full">
                    <li
                        class="flex items-start gap-4 pb-5 border-b border-custom-gold"
                    >
                        <div
                            class="w-12 h-12 rounded-full border-2 border-custom-gold flex items-center justify-center shrink-0 mt-1"
                        >
                            <HourglassIcon class="w-8 h-8 fill-custom-gold" />
                        </div>
                        <p
                            class="text-custom-white font-serif text-lg md:text-2xl leading-relaxed"
                        >
                            Zeit, Ruhe und ein offenes Ohr.<br />So empfangen
                            und begleiten wir Sie.
                        </p>
                    </li>

                    <li class="flex items-center gap-4">
                        <div
                            class="w-12 h-12 rounded-full border-2 border-custom-gold flex items-center justify-center shrink-0"
                        >
                            <StarIcon class="w-8 h-8 fill-custom-gold" />
                        </div>
                        <p
                            class="text-custom-white font-serif text-lg md:text-2xl leading-relaxed"
                        >
                            Individuell. Wunschgemäß. Für Sie.
                        </p>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <section class="overflow-hidden pt-16 px-4 bg-custom-green section-depth-b">
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute top-1/3 -right-40 w-md h-112 rounded-full bg-custom-gold/8 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-custom-light-gold/5 blur-3xl"
            >
            </div>
        </div>
        <div
            class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 md:items-stretch reveal"
        >
            <div class="flex flex-col justify-between h-full">
                <div>
                    <p
                        class="text-custom-gold text-lg md:text-xl tracking-[0.3em] uppercase mb-2 font-sans"
                    >
                        Leidenschaft · Präzision · Perfektion
                    </p>
                    <p
                        class="font-serif text-xl md:text-2xl text-custom-white tracking-widest leading-snug uppercase"
                    >
                        Nicht nur Worte –<br />sondern der Standard unserer
                        Arbeit.
                    </p>
                    <hr
                        class="w-full h-px border border-custom-gold my-6 rounded-lg"
                    />
                </div>

                <ul class="flex flex-col gap-5 justify-between flex-1">
                    {
                        [
                            {
                                icon: (
                                    <LeafIcon class="w-8 h-8 fill-custom-gold" />
                                ),
                                text: "Individualität steht bei uns im Mittelpunkt. Jede Behandlung wird genau auf Ihre Haut und Ihre Bedürfnisse abgestimmt.",
                            },
                            {
                                icon: (
                                    <CertificateIcon class="w-8 h-8 fill-custom-gold pt-1" />
                                ),
                                text: "Als zertifizierte Ganzheitskosmetikerin mit jahrelanger Erfahrung und umfangreicher Weiterbildungen betreuen wir Sie mit voller Aufmerksamkeit.",
                            },
                            {
                                icon: (
                                    <PersonIcon class="w-9 h-9 fill-custom-gold pl-1.25" />
                                ),
                                text: "Hier geht es nicht um Abarbeiten – hier geht es um Sie. \nSie stehen bei uns im Mittelpunkt jeder Behandlung.",
                            },
                            {
                                icon: (
                                    <CandleIcon class="w-13 h-13 fill-custom-gold" />
                                ),
                                text: "Unser Studio bietet ein Ambiente, welches den Alltag leiser werden lässt – ein Ort, an dem auch Sie zur Ruhe kommen.",
                            },
                        ].map(({ icon, text }) => (
                            <li class="flex items-center gap-4 py-1">
                                <div class="w-12 h-12 rounded-full border border-custom-gold flex items-center justify-center shrink-0">
                                    {icon}
                                </div>

                                <p class="flex-1 text-custom-white text-sm leading-relaxed font-serif whitespace-pre-line">
                                    {text}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="relative w-full">
                <Image
                    src={work}
                    alt="Einer unserer Arbeitsplätze in unserem Studio."
                    class="w-full h-auto rounded-lg border-2 border-custom-gold"
                />
            </div>
        </div>

        <div class="mt-12 flex justify-center">
            <Eucalyptus class="fill-custom-gold" />
        </div>
    </section>

    <Ionto />

    <section class="px-4 pt-8 md:pt-16 bg-custom-green section-depth-alt">
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute top-1/3 -right-40 w-md h-112 rounded-full bg-custom-gold/8 blur-3xl"
            >
            </div>
            <div
                class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-custom-light-gold/5 blur-3xl"
            >
            </div>
        </div>
        <div class="max-w-6xl mx-auto reveal">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {
                    [
                        {
                            title: "Exklusives Ambiente",
                            sub: "Luxus, der nicht laut ist – aber spürbar.",
                            icon: (
                                <PillarIcon class="w-11 h-11 fill-custom-gold" />
                            ),
                            image: bigwork,
                            alt: "Unser modernes Kosmetikatelier mit exklusivem Ambiente und moderner Ausstattung.",
                        },
                        {
                            title: "Hochwertige Produkte",
                            sub: "Wirksame Inhaltsstoffe. Sichtbare Ergebnisse.",
                            icon: (
                                <FlaskIcon class="w-8 h-8 fill-custom-gold" />
                            ),
                            image: ionto_light,
                            alt: "IONTO-COMED® Kabinettware und professionelle Pflegeprodukte für Behandlungen sowie zum Kauf im Atelier.",
                        },
                        {
                            title: "Ganzheitliche Pflege",
                            sub: "Für Haut, Körper und Seele.",
                            icon: (
                                <LotusIcon class="w-8 h-8 fill-custom-gold" />
                            ),
                            image: localBirdImage,
                            alt: "IONTO-COMED® Kabinettware und professionelle Pflegeprodukte für Behandlungen im Atelier",
                        },
                    ].map(({ title, sub, icon, image, alt }) => (
                        <div class="mx-8 border border-custom-gold/20 rounded-lg flex flex-col items-center text-center overflow-hidden card-elevated hover:gold-glow-lg hover:-translate-y-2 transition-all duration-500">
                            <div class="p-5 flex flex-col items-center gap-4 flex-1 bg-custom-light-green/10">
                                <div
                                    class="w-12 h-12 rounded-full
                                                bg-custom-gold/10
                                                border border-custom-gold
                                                shadow-[0_0_20px_rgba(200,170,90,0.15)]
                                                flex items-center justify-center"
                                >
                                    {icon}
                                </div>
                                <div>
                                    <p class="font-sans text-xs tracking-[0.2em] uppercase text-custom-gold mb-2">
                                        {title}
                                    </p>
                                    <p class="text-custom-white text-sm font-serif leading-relaxed">
                                        {sub}
                                    </p>
                                </div>
                                <div
                                    class="relative w-full rounded-lg overflow-hidden mt-auto aspect-square
                                            border border-custom-gold/20
                                            shadow-inner"
                                >
                                    <Image
                                        src={image}
                                        alt={alt}
                                        class="w-full h-full object-cover"
                                        width="400"
                                        height="400"
                                    />
                                    <div
                                        class="absolute inset-0
                                            bg-linear-to-t from-custom-green/50 via-transparent to-custom-gold/5
                                            pointer-events-none"
                                    />
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="mt-12 flex justify-center">
            <Eucalyptus class="fill-custom-gold" />
        </div>
    </section>

    <Faq />

    <section
        class="relative overflow-hidden mx-auto px-4 text-center py-8 md:py-16 bg-custom-green"
    >
        <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-xl h-64 rounded-full bg-custom-gold/6 blur-3xl"
            >
            </div>
        </div>
        <div class="reveal relative z-10">
            <p
                class="text-custom-gold text-xl md:text-2xl tracking-[0.2em] uppercase mb-4 font-sans px-2"
            >
                Schönheit ist Vertrauenssache.
            </p>
            <h2
                class="font-serif text-custom-white text-lg md:text-xl mb-8 italic font-light"
            >
                Wir freuen uns darauf, Sie kennenzulernen.
            </h2>

            <a
                href="/kontakt"
                class="inline-block w-full sm:w-auto px-8 py-4 rounded-lg border border-custom-gold text-custom-gold font-sans text-xs md:text-sm tracking-widest uppercase gold-glow hover:gold-glow-lg hover:bg-custom-gold hover:text-custom-green transition-all duration-300"
            >
                Jetzt kontaktieren und Termin vereinbaren
            </a>
        </div>
    </section>
</Layout>

<script>
    const revealEls = document.querySelectorAll(".reveal");

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("reveal-visible");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
    );

    revealEls.forEach((el) => observer.observe(el));

    function setupBeforeAfterSliders() {
        const containers = document.querySelectorAll(".before-after-container");

        containers.forEach((container) => {
            const slider = container.querySelector(
                ".before-after-slider",
            ) as HTMLInputElement;
            const beforeWrapper = container.querySelector(
                ".before-img-wrapper",
            ) as HTMLElement;
            const line = container.querySelector(".slider-line") as HTMLElement;

            if (!slider || !beforeWrapper || !line) return;

            const updateSlider = () => {
                const value = slider.value;
                beforeWrapper.style.clipPath = `inset(0 ${100 - Number(value)}% 0 0)`;
                line.style.left = `${value}%`;
            };

            slider.addEventListener("input", updateSlider);
            // Für Touch-Geräte
            slider.addEventListener("change", updateSlider);
        });
    }

    setupBeforeAfterSliders();

    document.addEventListener("astro:page-load", setupBeforeAfterSliders);
</script>
