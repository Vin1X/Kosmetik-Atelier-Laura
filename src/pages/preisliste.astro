---

<Layout title="Preisliste" isTextPage={true}>
  <section class="relative overflow-hidden mb-4 max-w-3xl mx-auto">
    <p
      class="text-center text-xs text-custom-light-white/70 font-sans mb-6 md:mb-10 tracking-widest uppercase"
    >
      Alle Preise inkl. MwSt. · Änderungen vorbehalten
    </p>

    <div class="flex flex-col gap-4">
      {
        categories.map((cat) => (
          <details
            class="group overflow-hidden rounded-xl bg-custom-green/30 border border-white/5"
            open={cat.open}
          >
            <summary class="flex justify-between items-center px-6 py-4 cursor-pointer list-none select-none transition-colors duration-200 hover:bg-white/5">
              <h2 class="font-serif text-xl text-custom-gold tracking-wide font-normal">
                {cat.title}
              </h2>
              <svg
                class="w-4 h-4 text-custom-gold/70 transition-transform duration-300 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </summary>

            <div class="px-6 pb-5 pt-1">
              {cat.description && (
                <p class="text-xs font-sans text-custom-light-gold italic mb-4 pb-2 border-b border-white/10">
                  {cat.description}
                </p>
              )}

              <ul class="flex flex-col divide-y divide-white/10">
                {cat.items.map((item) => (
                  <li class="py-3.5 first:pt-1 last:pb-1">
                    {item.price === "" ? (
                      <div class="pt-3 pb-1">
                        <span class="text-custom-light-gold font-sans text-xs font-semibold uppercase tracking-wider block">
                          {item.name}
                        </span>
                      </div>
                    ) : (
                      <>
                        <div class="flex justify-between items-baseline gap-4">
                          <span class="text-custom-white font-sans text-sm font-medium tracking-wide">
                            {item.name}
                          </span>
                          <span class="text-custom-gold font-sans font-semibold text-sm tracking-tight tabular-nums whitespace-nowrap">
                            {item.price}
                          </span>
                        </div>

                        {item.description && (
                          <p class="text-xs font-sans text-custom-light-white/75 mt-1 leading-relaxed max-w-[90%]">
                            {item.description}
                          </p>
                        )}

                        {item.extras && item.extras.length > 0 && (
                          <ul class="mt-2.5 ml-1 border-l-2 border-custom-gold/30 pl-3 flex flex-col gap-1.5">
                            {item.extras.map((e) => (
                              <li class="flex justify-between items-baseline text-xs font-sans">
                                <span class="text-custom-light-white/80 italic">
                                  {e.label}
                                </span>
                                <span class="text-custom-gold/90 font-medium tabular-nums whitespace-nowrap ml-2">
                                  {e.price}
                                </span>
                              </li>
                            ))}
                          </ul>
                        )}

                        {item.packages && item.packages.length > 0 && (
                          <div class="mt-3 bg-custom-gold/10 border border-custom-gold/20 rounded-lg p-3">
                            <ul class="flex flex-col gap-1">
                              {item.packages.map((p) => (
                                <li class="flex justify-between items-center text-xs font-sans">
                                  <span class="text-custom-white/90 font-medium">
                                    {p.label}
                                  </span>
                                  <span class="text-custom-gold font-semibold tabular-nums whitespace-nowrap bg-custom-green/60 px-2 py-0.5 rounded border border-custom-gold/30">
                                    {p.price}
                                  </span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))
      }
    </div>
  </section>
</Layout>
