---
import { Image } from "astro:assets";
import localBirdImage from "../assets/image21.webp";

import afterImage from "../assets/image2.jpeg";
---

<section
    class="relative overflow-hidden pt-16 px-4 bg-custom-green section-depth"
>
    <div class="absolute inset-0 overflow-hidden -z-10 pointer-events-none">
        <div
            class="absolute top-1/3 -right-40 w-md h-112 rounded-full bg-custom-gold/8 blur-3xl"
        >
        </div>
        <div
            class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-custom-light-gold/5 blur-3xl"
        >
        </div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto reveal">
        <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
            <p
                class="text-custom-gold text-xs md:text-sm tracking-[0.3em] uppercase mb-3 font-sans"
            >
                Ionto-Comed® Gerätetechnik
            </p>
            <h2 class="font-serif text-3xl md:text-5xl text-custom-white mb-4">
                Unsere gefragtesten Behandlungen
            </h2>
            <p
                class="font-serif text-custom-white/70 text-base md:text-lg italic font-light"
            >
                Hauterneuerung auf höchstem Niveau – präzise apparative Kosmetik
                für sofort sichtbare Frische, tiefenwirksame Regeneration und
                einen strahlenden Teint.
            </p>
        </div>

        <div class="flex flex-col gap-24 md:gap-32">
            <!-- 1. MICRONEEDLING -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center"
            >
                <div class="relative order-1">
                    <div
                        class="absolute inset-0 border-2 border-custom-gold rounded-lg -z-10"
                    >
                    </div>

                    <div
                        class="before-after-container relative w-full aspect-4/5 rounded-lg border border-custom-gold/20 overflow-hidden select-none"
                    >
                        <Image
                            src={afterImage}
                            alt="Microneedling Ergebnis Nachher"
                            class="absolute inset-0 w-full h-full object-cover"
                        />
                        <span
                            class="absolute bottom-3 right-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                        >
                            Nachher
                        </span>

                        <div
                            class="before-img-wrapper absolute inset-0 w-full h-full z-10 overflow-hidden"
                            style="clip-path: inset(0 50% 0 0);"
                        >
                            <Image
                                src={localBirdImage}
                                alt="Microneedling Hautzustand Vorher"
                                class="absolute inset-0 w-full h-full object-cover"
                            />
                            <span
                                class="absolute bottom-3 left-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                            >
                                Vorher
                            </span>
                        </div>

                        <div
                            class="slider-line absolute top-0 bottom-0 left-1/2 w-0.5 bg-custom-gold z-20 pointer-events-none -translate-x-1/2"
                        >
                            <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-custom-gold text-custom-green flex items-center justify-center shadow-xl"
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    class="w-4 h-4 stroke-custom-green fill-none"
                                    stroke-width="2.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
                                </svg>
                            </div>
                        </div>

                        <input
                            type="range"
                            min="0"
                            max="100"
                            value="50"
                            aria-label="Vorher und Nachher Vergleich verstellen"
                            class="before-after-slider absolute inset-0 w-full h-full opacity-0 z-30 cursor-ew-resize"
                        />
                    </div>
                </div>

                <div class="order-2">
                    <p
                        class="text-custom-gold text-xs md:text-sm tracking-[0.25em] uppercase mb-3 font-sans"
                    >
                        Tiefenwirksame Hauterneuerung
                    </p>
                    <h3
                        class="font-serif text-3xl md:text-4xl text-custom-white mb-4"
                    >
                        Microneedling
                    </h3>
                    <p
                        class="text-custom-white/80 font-serif text-base md:text-lg leading-relaxed mb-6"
                    >
                        Aktivieren Sie die natürliche Verjüngungskraft Ihrer
                        Haut: Durch feine, kontrollierte Mikroimpulse regt die
                        Ionto-Comed® Technologie die körpereigene Kollagen- und
                        Elastinbildung an – für spürbar mehr Spannkraft und
                        verfeinerte Hautstrukturen.
                    </p>
                    <ul class="flex flex-col gap-3 mb-8">
                        {
                            [
                                "Aktivierung der körpereigenen Kollagen- & Elastinsynthese",
                                "Sichtbare Minderung von Fältchen, Aknenarben & Pigmentflecken",
                                "Maximale Tiefenwirkung durch gezieltes Einschleusen von Wirkstoffen",
                                "Sanfte & präzise Behandlung dank individuell angepasster Nadeltiefe",
                            ].map((point) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="w-4 h-4 mt-1 stroke-custom-gold fill-none shrink-0"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    <span class="text-custom-white/90 text-sm font-serif leading-relaxed">
                                        {point}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                    <a
                        href="/kontakt"
                        class="inline-flex items-center gap-2 text-custom-gold text-xs md:text-sm tracking-widest uppercase font-sans border-b border-custom-gold pb-1 hover:gap-3 transition-all duration-300"
                    >
                        Termin für Microneedling anfragen
                        <svg
                            viewBox="0 0 24 24"
                            class="w-4 h-4 stroke-custom-gold fill-none"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13 7l5 5-5 5M6 12h12"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- 2. MIKRODERMABRASION -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center"
            >
                <div class="order-2 md:order-1">
                    <p
                        class="text-custom-gold text-xs md:text-sm tracking-[0.25em] uppercase mb-3 font-sans"
                    >
                        Präzises Intensiv-Peeling
                    </p>
                    <h3
                        class="font-serif text-3xl md:text-4xl text-custom-white mb-4"
                    >
                        Mikrodermabrasion
                    </h3>
                    <p
                        class="text-custom-white/80 font-serif text-base md:text-lg leading-relaxed mb-6"
                    >
                        Befreien Sie Ihre Haut sanft von verhornten
                        Hautschichten und grauem Schleier. Die apparative
                        Mikrodermabrasion von Ionto Comed regt die
                        Mikrozirkulation sowie die Zellerneuerung an – für ein
                        samtweiches Hautgefühl und einen strahlenden Glow.
                    </p>
                    <ul class="flex flex-col gap-3 mb-8">
                        {
                            [
                                "Sofort sichtbarer Frische- & Glow-Effekt ab der ersten Anwendung",
                                "Porentiefe Befreiung von Verhornungen & Verunreinigungen",
                                "Steigert die Aufnahmebereitschaft für Ihre tägliche Pflege drastisch",
                                "Schonend & effektiv – ideal auch als Vorbereitung weiterer Treatments",
                            ].map((point) => (
                                <li class="flex items-start gap-3">
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="w-4 h-4 mt-1 stroke-custom-gold fill-none shrink-0"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    <span class="text-custom-white/90 text-sm font-serif leading-relaxed">
                                        {point}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                    <a
                        href="/kontakt"
                        class="inline-flex items-center gap-2 text-custom-gold text-xs md:text-sm tracking-widest uppercase font-sans border-b border-custom-gold pb-1 hover:gap-3 transition-all duration-300"
                    >
                        Termin für Mikrodermabrasion anfragen
                        <svg
                            viewBox="0 0 24 24"
                            class="w-4 h-4 stroke-custom-gold fill-none"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13 7l5 5-5 5M6 12h12"></path>
                        </svg>
                    </a>
                </div>

                <div class="relative order-1 md:order-2">
                    <div
                        class="absolute inset-0 border-2 border-custom-gold rounded-lg -z-10"
                    >
                    </div>

                    <div
                        class="before-after-container relative w-full aspect-4/5 rounded-lg border border-custom-gold/20 overflow-hidden select-none"
                    >
                        <Image
                            src={afterImage}
                            alt="Mikrodermabrasion Ergebnis Nachher"
                            class="absolute inset-0 w-full h-full object-cover"
                        />
                        <span
                            class="absolute bottom-3 right-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                        >
                            Nachher
                        </span>

                        <div
                            class="before-img-wrapper absolute inset-0 w-full h-full z-10 overflow-hidden"
                            style="clip-path: inset(0 50% 0 0);"
                        >
                            <Image
                                src={localBirdImage}
                                alt="Mikrodermabrasion Zustand Vorher"
                                class="absolute inset-0 w-full h-full object-cover"
                            />
                            <span
                                class="absolute bottom-3 left-3 z-10 bg-black/60 backdrop-blur-md text-custom-white text-[10px] font-sans tracking-widest uppercase px-2 py-1 rounded"
                            >
                                Vorher
                            </span>
                        </div>

                        <div
                            class="slider-line absolute top-0 bottom-0 left-1/2 w-0.5 bg-custom-gold z-20 pointer-events-none -translate-x-1/2"
                        >
                            <div
                                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-custom-gold text-custom-green flex items-center justify-center shadow-xl"
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    class="w-4 h-4 stroke-custom-green fill-none"
                                    stroke-width="2.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>
                                </svg>
                            </div>
                        </div>

                        <input
                            type="range"
                            min="0"
                            max="100"
                            value="50"
                            aria-label="Vorher und Nachher Vergleich verstellen"
                            class="before-after-slider absolute inset-0 w-full h-full opacity-0 z-30 cursor-ew-resize"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-center pt-12">
        <div class="h-px w-10 bg-custom-gold"></div>
        <svg
            viewBox="0 0 40 12"
            class="w-10 h-3 fill-custom-gold"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M20 0 C14 4, 6 6, 0 6 C6 6, 14 8, 20 12 C26 8, 34 6, 40 6 C34 6, 26 4, 20 0Z"
            ></path>
        </svg>
        <div class="h-px w-10 bg-custom-gold"></div>
    </div>
</section>
