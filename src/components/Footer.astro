---
const currentYear = new Date().getFullYear();
---

<footer
    class="mt-auto border-t border-gray-200 py-10 px-6 text-custom-white font-serif bg-custom-green"
>
    <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8 text-center">
        <div class="hidden md:flex flex-col items-center">
            <p class="text-custom-white font-bold font-serif tracking-wide">
                Navigation
            </p>
            <hr class="w-1/3 border-gray-300 my-2" />
            <ul class="flex flex-col gap-1 text-sm">
                <li>
                    <a
                        href="/"
                        class="hover:text-custom-light-gold hover:underline transition-colors duration-200"
                        >Startseite</a
                    >
                </li>
                <li>
                    <a
                        href="/preisliste"
                        class="hover:text-custom-light-gold hover:underline transition-colors duration-200"
                        >Preisliste</a
                    >
                </li>
                <li>
                    <a
                        href="/kontakt"
                        class="hover:text-custom-light-gold hover:underline transition-colors duration-200"
                        >Kontakt</a
                    >
                </li>
            </ul>
        </div>

        <div class="flex flex-col items-center">
            <p class="text-custom-white font-bold font-serif tracking-wide">
                Öffnungszeiten
            </p>
            <hr class="w-1/3 border-gray-300 my-2" />
            <ul class="text-sm leading-relaxed mb-3">
                <li class="flex justify-center gap-4">
                    <span class="w-16 text-left">Mo – Fr</span><span
                        >09:00 – 17:00</span
                    >
                </li>
                <li class="flex justify-center gap-4">
                    <span class="w-16 text-left">Sa & So</span><span
                        >Geschlossen</span
                    >
                </li>
            </ul>
            <p class="text-sm">
                <a
                    href="https://wa.me/message/VNC2WZRCMIXSA1"
                    class="hover:text-custom-light-gold hover:underline transition-colors duration-200"
                >
                    💬 WhatsApp
                </a>
            </p>
            <p class="text-sm">
                <a
                    href="tel:+49303723560"
                    class="hover:text-custom-light-gold hover:underline transition-colors duration-200"
                    >📞 030/372 35 60</a
                >
            </p>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div
        class="max-w-4xl mx-auto mt-8 pt-4 border-t border-gray-300 flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-custom-white"
    >
        <p>© {currentYear} Kosmetik Atelier Laura. Alle Rechte vorbehalten.</p>
        <div class="flex gap-4">
            <a
                href="/impressum"
                class="hover:text-custom-light-gold hover:underline transition-colors duration-200"
                >Impressum</a
            >
            <a
                href="/datenschutz"
                class="hover:text-custom-light-gold hover:underline transition-colors duration-200"
                >Datenschutz</a
            >
        </div>
    </div>
</footer>
