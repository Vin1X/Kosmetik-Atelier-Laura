<script>
    const header = document.getElementById("main-header");
    const toggle = document.getElementById("menu-toggle");
    const nav = document.getElementById("main-nav");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    let lastScrollY = window.scrollY;
    let isMenuOpen = false;

    window.addEventListener("scroll", () => {
        if (isMenuOpen || window.innerWidth >= 768) return;

        const currentScrollY = window.scrollY;

        if (currentScrollY > lastScrollY && currentScrollY > 50) {
            header?.classList.add("-translate-y-full");
        } else if (currentScrollY < lastScrollY) {
            header?.classList.remove("-translate-y-full");
        }

        lastScrollY = currentScrollY;
    });

    toggle?.addEventListener("click", () => {
        isMenuOpen = nav?.classList.toggle("flex") ?? false;
        nav?.classList.toggle("hidden", !isMenuOpen);

        toggle.setAttribute("aria-expanded", String(isMenuOpen));
        toggle.setAttribute(
            "aria-label",
            isMenuOpen ? "Menü schließen" : "Menü öffnen",
        );

        iconOpen?.classList.toggle("hidden", isMenuOpen);
        iconClose?.classList.toggle("hidden", !isMenuOpen);
    });
</script>
