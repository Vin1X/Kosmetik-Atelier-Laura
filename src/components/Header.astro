                            <stop offset="25%" stop-color="#CBA358"></stop>
                            <stop offset="45%" stop-color="#F7E5A9"></stop>
                            <stop offset="55%" stop-color="#F7E5A9"></stop>
                            <stop offset="75%" stop-color="#CBA358"></stop>
