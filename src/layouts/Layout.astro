---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  isTextPage?: boolean;
}

const { title = "Kosmetik Atelier Laura", isTextPage = false } = Astro.props;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/inter-v20-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/playfair-display-v40-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <Header />
    <article>
      {
        isTextPage ? (
          <main class="p-5 md:pb-8 bg-custom-green">
            <div class="max-w-3xl mx-auto w-full">
              <slot />
            </div>
          </main>
        ) : (
          <slot />
        )
      }
    </article>

    <Footer />
  </body>
</html>
